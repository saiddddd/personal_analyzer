# Ini CONTOH/TEMPLATE, bukan secrets asli.
#
# CARA PAKAI DI LOKAL:
# 1. Copy file ini jadi ".streamlit/secrets.toml" (hapus ".example")
# 2. Isi GROQ_API_KEY dengan key asli kamu
# 3. File ".streamlit/secrets.toml" TIDAK akan ter-commit ke git (sudah ada di .gitignore)
#
# CARA PAKAI DI STREAMLIT COMMUNITY CLOUD:
# Isi nilai yang sama ini lewat menu App settings -> Secrets di dashboard
# share.streamlit.io, BUKAN dengan commit file ini ke GitHub.

GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
